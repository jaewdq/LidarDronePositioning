# 라이다2 보정값 — 예시 (실제 값 아님)
#
#   이 파일은 그대로 쓰면 안 된다. calibrate 를 돌려서
#   calibration_lidar2.yaml 을 새로 만들어야 한다.
#
#     ros2 run dual_ouster_driver calibrate --ros-args \
#       -p lidar_ids:="[1,2]" -p front_axis:=+y -p marker_radius:=0.045
#
#   보정값은 라이다 위치·자세·설치 장소마다 전부 다르다.
#   남의 보정값을 쓰면 오류 없이 조용히 틀린 좌표가 나온다.
#
# 아래는 값의 형식과 의미를 보여주기 위한 것이다.
# (2026-08-24 항공대 실내, 라이다 2대 마주보기 배치에서 나온 값)

/**:                       # 노드 이름과 무관하게 적용. roi_filter_1 등도 먹는다
  ros__parameters:
    lidar_z: 0.0           # 바닥에서 라이다까지 높이 (m).  0 = 미보정 표시
    yaw_deg: 0.0           # 라이다 프레임을 월드로 돌리는 각 (도)
    origin_x: 0.0          # 회전 후 빼줄 원점 (m)
    origin_y: 0.0

    roi_x_min: -0.20       # 비행 영역 (map 좌표, m)
    roi_x_max: 3.90
    roi_y_min: -1.30
    roi_y_max: 3.10
    roi_z_min: 0.30
    roi_z_max: 2.50

    min_range: 0.1         # 이보다 가까운 점은 자기 몸통 반사로 보고 버린다
    input_topic: /lidar2/points
    output_topic: /lidar2/roi_points
    output_frame: map
