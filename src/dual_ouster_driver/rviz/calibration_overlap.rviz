Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 8
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L1_world_CYAN
      Alpha: 0.8
      Topic:
        Value: /lidar1/points_world
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 0; 230; 230
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L2_world_ORANGE
      Alpha: 0.8
      Topic:
        Value: /lidar2/points_world
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 140; 0
  Global Options:
    Fixed Frame: world
    Background Color: 25; 25; 28
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 2
        Y: 1.4
        Z: 1
      Yaw: 1.5
      Pitch: 1.2
Window Geometry:
  Height: 900
  Width: 1400
