Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 8
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Clusters
      Namespaces:
        {}
      Topic:
        Value: /lidar/cluster_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: EstimatedPose
      Color: 0; 255; 0
      Alpha: 1
      Shaft Length: 0.8
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.18
      Covariance:
        Value: true
        Position:
          Alpha: 0.25
          Color: 0; 255; 0
          Scale: 1
        Orientation:
          Value: false
      Topic:
        Value: /drone/estimated_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: false
      Name: L1_pose
      Color: 0; 200; 255
      Alpha: 0.7
      Shaft Length: 0.15
      Shaft Radius: 0.02
      Head Length: 0.06
      Head Radius: 0.04
      Covariance:
        Value: false
      Topic:
        Value: /drone/lidar1_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: false
      Name: L2_pose
      Color: 255; 160; 0
      Alpha: 0.7
      Shaft Length: 0.15
      Shaft Radius: 0.02
      Head Length: 0.06
      Head Radius: 0.04
      Covariance:
        Value: false
      Topic:
        Value: /drone/lidar2_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: WaypointEstimates
      Namespaces:
        {}
      Topic:
        Value: /drone/waypoint_estimates
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: EstimateText
      Namespaces:
        {}
      Topic:
        Value: /drone/estimate_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: EstimateTrail
      Alpha: 1
      Topic:
        Value: /drone/estimate_cloud
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
  Global Options:
    Fixed Frame: world
    Background Color: 25; 25; 28
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 2
        Y: 1.4
        Z: 1
      Yaw: 1.5
      Pitch: 1.2
Window Geometry:
  Height: 900
  Width: 1400
